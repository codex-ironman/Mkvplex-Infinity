 import org.junit.Test
 
 class JellyfinJsonResponseTest {
+  @Test fun threeThousandRichLinksKeepIdentityAndTracksWithoutProviderCatalogCopies() {
+    for (count in listOf(1000, 2000, 3000)) {
+      val links = (0 until count).joinToString(",") { index ->
+        """{"Id":"source-$index","Name":"Movie Hindi English $index","Container":"mkv","Size":123456789,"Bitrate":10000000,"Overview":"${"unused".repeat(100)}","People":[{"Name":"ignored"}],"MediaStreams":[{"Index":0,"Type":"Video","Codec":"hevc","DisplayTitle":"4K HDR","Width":3840},{"Index":1,"Type":"Audio","Codec":"eac3","Language":"hin","DisplayTitle":"Hindi 5.1"},{"Index":2,"Type":"Subtitle","Codec":"srt","Language":"eng","IsExternal":true,"DeliveryUrl":"/Subtitles/$index.srt"}]}"""
+      }
+      val root = JellyfinJsonResponse.read("""{"MediaSources":[$links]}""".byteInputStream(), true,
+        maxInputBytes = 128L * 1024 * 1024, maxRetainedBytes = 32L * 1024 * 1024).jsonObject
+      val sources = JellyfinMediaSourceParser.parse(root, "movie")
+      assertEquals(count, sources.size)
+      assertEquals("source-${count - 1}", sources.last().id)
+      assertEquals("/Subtitles/${count - 1}.srt", sources.last().streams.last().deliveryUrl)
+      val indexed = app.infinity.mpvz.domain.jellyfin.JellyfinSourceFilter.index(sources)
+      assertEquals("source-${count - 1}", app.infinity.mpvz.domain.jellyfin.JellyfinSourceFilter
+        .filter(indexed, "Hindi", "${count - 1}").single().id)
+      assertFalse(root["MediaSources"]!!.jsonArray.first().jsonObject.containsKey("Overview"))
+      assertFalse(root["MediaSources"]!!.jsonArray.first().jsonObject.containsKey("People"))
+    }
+  }
