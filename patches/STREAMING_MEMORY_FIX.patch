+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.utils
+
+import android.util.Log
+
+/** Only fixed stage names and numeric counters; never URLs, metadata, tokens or credentials. */
+internal object AppMemoryDiagnostics {
+  fun record(counters: String) {
+    val runtime = Runtime.getRuntime()
+    val used = (runtime.totalMemory() - runtime.freeMemory()) / (1024 * 1024)
+    try { Log.i("MkvMemory", "$counters heapMiB=$used/${runtime.maxMemory() / (1024 * 1024)}") }
+    catch (_: RuntimeException) { /* Android's Log stub is absent in local JVM tests. */ }
+  }
+}
diff --git a/app/src/test/java/app/infinity/mpvz/data/jellyfin/JellyfinJsonResponseTest.kt b/app/src/test/java/app/infinity/mpvz/data/jellyfin/JellyfinJsonResponseTest.kt
