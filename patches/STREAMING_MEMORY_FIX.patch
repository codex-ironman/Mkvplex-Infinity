+++ b/app/src/test/java/app/infinity/mpvz/presentation/components/SharedImageRequestsTest.kt
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.presentation.components
+
+import kotlinx.coroutines.*
+import kotlinx.coroutines.channels.Channel
+import org.junit.Assert.*
+import org.junit.Test
+import java.util.concurrent.atomic.AtomicInteger
+
+class SharedImageRequestsTest {
+  @Test fun twoViewersShareWorkAndCancellingOneDoesNotCancelTheOther() = runBlocking {
+    val requests = SharedImageRequests<String>()
+    val calls = AtomicInteger()
+    val started = CompletableDeferred<Unit>()
+    val release = CompletableDeferred<Unit>()
+    val first = async { requests.load("same") { calls.incrementAndGet(); started.complete(Unit); release.await(); "bitmap" } }
+    withTimeout(3000) { started.await() }
+    val second = async(start = CoroutineStart.UNDISPATCHED) { requests.load("same") { error("Duplicate work") } }
+    first.cancelAndJoin()
+    release.complete(Unit)
+    assertEquals("bitmap", withTimeout(3000) { second.await() })
+    assertEquals(1, calls.get())
+  }
+  @Test fun lastViewerCancelsInFlightWork() = runBlocking {
+    val requests = SharedImageRequests<Unit>()
+    val started = CompletableDeferred<Unit>()
+    val cancelled = CompletableDeferred<Unit>()
+    val viewer = launch {
+      requests.load("image") {
+        started.complete(Unit)
+        try { awaitCancellation() } finally { cancelled.complete(Unit) }
+      }
+    }
+    withTimeout(3000) { started.await() }
+    viewer.cancelAndJoin()
+    withTimeout(3000) { cancelled.await() }
+  }
+  @Test fun boundsConcurrentDecodesAndCancelledQueuedRequestsNeverStart() = runBlocking {
+    val requests = SharedImageRequests<Unit>(2)
+    val started = Channel<String>(Channel.UNLIMITED)
+    val active = AtomicInteger()
+    val peak = AtomicInteger()
+    fun viewer(index: Int) =
+      async(start = CoroutineStart.UNDISPATCHED) {
+        requests.load("$index") {
+          val count = active.incrementAndGet()
+          peak.updateAndGet { maxOf(it, count) }
+          started.send("$index")
+          try { awaitCancellation() } finally { active.decrementAndGet() }
+        }
+      }
+    val viewers = (1..2).map { viewer(it) }
+    withTimeout(3000) { repeat(2) { started.receive() } }
+    val queued = (3..4).map { viewer(it) }
+    queued.forEach { it.cancelAndJoin() }
+    viewers.forEach { it.cancelAndJoin() }
+    assertEquals(2, peak.get())
+    assertTrue(started.tryReceive().isFailure)
+  }
+  @Test fun aFailureDoesNotPoisonFutureLoadsOfTheSameImage() = runBlocking {
+    val requests = SharedImageRequests<String>()
+    try { requests.load("same") { error("network") }; fail("Expected request failure") } catch (_: IllegalStateException) {}
+    assertEquals("retry", requests.load("same") { "retry" })
+  }
+}
