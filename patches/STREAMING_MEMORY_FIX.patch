+++ b/app/src/main/java/app/infinity/mpvz/presentation/components/RemoteImagePolicy.kt
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.presentation.components
+
+internal enum class RemoteImageSize(val maxDimension: Int, val maxPixels: Long) {
+  CARD(768, 512L * 768), HERO(1536, 1536L * 864),
+}
+
+internal object RemoteImagePolicy {
+  /** Ceil division matches decoders that round sampled dimensions up. */
+  fun sampleSize(width: Int, height: Int, size: RemoteImageSize): Int {
+    require(width > 0 && height > 0)
+    var sample = 1
+    while (true) {
+      val w = (width.toLong() + sample - 1) / sample
+      val h = (height.toLong() + sample - 1) / sample
+      if (w <= size.maxDimension && h <= size.maxDimension && w * h <= size.maxPixels) return sample
+      sample *= 2
+    }
+  }
+}
