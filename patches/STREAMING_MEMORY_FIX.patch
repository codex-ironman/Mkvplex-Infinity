+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.presentation.components
+
+import kotlinx.coroutines.*
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+
+/** Coalesce active viewers, bound decoding, and cancel work when its last viewer leaves. */
+internal class SharedImageRequests<T>(parallelism: Int = 2) {
+  private class Entry<T>(val task: Deferred<T>, var readers: Int = 0)
+  private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+  private val slots = Semaphore(parallelism)
+  private val entries = mutableMapOf<String, Entry<T>>()
+
+  suspend fun load(key: String, request: suspend () -> T): T {
+    val entry = synchronized(entries) {
+      entries.getOrPut(key) {
+        Entry(scope.async(start = CoroutineStart.LAZY) {
+          slots.withPermit {
+            currentCoroutineContext().ensureActive()
+            request().also { currentCoroutineContext().ensureActive() }
+          }
+        })
+      }.also { it.readers++ }
+    }
+    try { return entry.task.await() }
+    finally {
+      synchronized(entries) {
+        entry.readers--
+        if (entry.readers == 0) {
+          if (entries[key] === entry) entries.remove(key)
+          entry.task.cancel()
+        }
+      }
+    }
+  }
+}
