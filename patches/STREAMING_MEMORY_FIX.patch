--- /dev/null
+++ b/app/src/test/java/app/infinity/mpvz/data/jellyfin/JellyfinJsonResponseTest.kt
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.data.jellyfin
+
+import app.infinity.mpvz.network.ResponseLimitException
+import java.io.ByteArrayInputStream
+import java.io.InputStream
+import java.io.SequenceInputStream
+import java.util.Collections
+import kotlinx.serialization.json.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class JellyfinJsonResponseTest {
+  companion object {
+    /** A large fixture with constant memory, including during a 64 MiB stress run. */
+    fun largeIgnoredField(): InputStream {
+      val prefix = """{"Items":[{"Id":"movie","Name":"Movie","MediaSources":[{"Id":"link","Name":"Hindi 4K","Unused":"""".toByteArray()
+      val repeat = object : InputStream() {
+        var remaining = 24 * 1024 * 1024
+        override fun read(): Int = if (remaining-- > 0) 65 else -1
+        override fun read(b: ByteArray, off: Int, len: Int): Int {
+          if (remaining <= 0) return -1
+          val count = minOf(len, remaining)
+          java.util.Arrays.fill(b, off, off + count, 65.toByte())
+          remaining -= count
+          return count
+        }
+      }
+      val suffix = "\"}]}],\"TotalRecordCount\":1}".toByteArray()
+      return SequenceInputStream(Collections.enumeration(listOf(ByteArrayInputStream(prefix), repeat, ByteArrayInputStream(suffix))))
+    }
+  }
+
+  private fun read(text: String, sources: Boolean = false) =
+    JellyfinJsonResponse.read(text.byteInputStream(), sources)
+
+  @Test fun browseSkipsUnrequestedSourcesBeforeTheyBecomeJsonObjects() {
+    val root = JellyfinJsonResponse.read(largeIgnoredField()).jsonObject
+    val item = root["Items"]!!.jsonArray.single().jsonObject
+    assertEquals("movie", item["Id"]!!.jsonPrimitive.content)
+    assertFalse(item.containsKey("MediaSources"))
+  }
+  @Test fun sourceRequestsKeepAllVersionsButSkipLargeUnusedProviderFields() {
+    val root = JellyfinJsonResponse.read(largeIgnoredField(), true).jsonObject
+    val source = root["Items"]!!.jsonArray.single().jsonObject["MediaSources"]!!.jsonArray.single().jsonObject
+    assertEquals("Hindi 4K", source["Name"]!!.jsonPrimitive.content)
+    assertFalse(source.containsKey("Unused"))
+  }
+  @Test fun preservesExactNumbersUnicodeAndExternalSubtitleSelection() {
+    val root = read("""{"MediaSources":[{"Id":"source?x=1&y=2","Name":"हिंदी","Size":9223372036854775807,"MediaStreams":[{"Index":4,"Type":"Subtitle","IsExternal":true,"DeliveryUrl":"/Videos/a/Subtitles/4.srt"}]}]}""", true).jsonObject
+    val item = JellyfinMediaSourceParser.parse(root, "movie").single()
+    assertEquals("source?x=1&y=2", item.id)
+    assertEquals("हिंदी", item.name)
+    assertEquals(Long.MAX_VALUE, item.size)
+    assertTrue(item.streams.single().isExternal)
+    assertEquals("/Videos/a/Subtitles/4.srt", item.streams.single().deliveryUrl)
+  }
+  @Test fun normalLargeVersionListsAreNotSilentlyTruncated() {
+    val sources = (0..999).joinToString(",") { """{"Id":"$it","Name":"Hindi $it","Container":"mkv"}""" }
+    val root = read("""{"MediaSources":[$sources]}""", true).jsonObject
+    assertEquals(1_000, JellyfinMediaSourceParser.parse(root, "movie").size)
+  }
+  @Test fun retainedMetadataBudgetFailsExplicitly() {
+    try {
+      JellyfinJsonResponse.read("""{"Name":"${"a".repeat(2_000)}"}""".byteInputStream(), maxRetainedBytes = 1_024)
+      fail("Expected retained budget failure")
+    } catch (error: ResponseLimitException) {
+      assertFalse(error.message.orEmpty().contains("aaaa"))
+    }
+  }
+  @Test fun inputBudgetAlsoAppliesToSkippedUnknownFields() {
+    try {
+      JellyfinJsonResponse.read(largeIgnoredField(), maxInputBytes = 1_024)
+      fail("Expected streamed input budget failure")
+    } catch (_: ResponseLimitException) {}
+  }
+  @Test fun preservesPlaybackErrorsAndBrowseMetadata() {
+    val root = read("""{"ErrorCode":"NotAllowed","TotalRecordCount":2,"Items":[{"Id":"a","People":[{"Id":"p","Role":"Actor"}],"UserData":{"Played":true},"ImageTags":{"Primary":"image"},"Genres":["Action"]}]}""").jsonObject
+    assertEquals("NotAllowed", root["ErrorCode"]!!.jsonPrimitive.content)
+    assertTrue(root["Items"]!!.jsonArray.single().jsonObject["UserData"]!!.jsonObject["Played"]!!.jsonPrimitive.boolean)
+    assertEquals("image", root["Items"]!!.jsonArray.single().jsonObject["ImageTags"]!!.jsonObject["Primary"]!!.jsonPrimitive.content)
+  }
+  @Test fun excessiveNestingDoesNotOverflowTheStack() {
+    try {
+      read("{\"Items\":" + "[".repeat(100) + "null" + "]".repeat(100) + "}")
+      fail("Expected depth budget failure")
+    } catch (_: ResponseLimitException) {}
+  }
+}
