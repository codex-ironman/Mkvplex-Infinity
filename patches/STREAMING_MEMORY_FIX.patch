@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.domain.jellyfin
+
+/** Bound text passed to Compose without changing source IDs, URLs or search metadata. */
+internal object JellyfinSourceText {
+  fun name(source: JellyfinMediaSource): String = source.name.take(1024)
+
+  fun description(source: JellyfinMediaSource, limit: Int = 1536): String {
+    require(limit > 0)
+    val result = StringBuilder()
+    fun append(text: String?, separator: String) {
+      if (text.isNullOrBlank() || result.length >= limit) return
+      if (result.isNotEmpty()) result.append(separator.take(limit - result.length))
+      val remaining = limit - result.length
+      result.append(text, 0, minOf(text.length, remaining))
+    }
+    source.streams.firstOrNull { it.type.equals("Video", true) }?.displayTitle?.let { append(it, " • ") }
+    val seen = HashSet<String>()
+    for (stream in source.streams) {
+      if (result.length >= limit) break
+      if (!stream.type.equals("Audio", true)) continue
+      val label = stream.displayTitle ?: stream.language ?: stream.codec ?: continue
+      if (seen.add(label)) append(label, " / ")
+    }
+    // Only numeric/container metadata, so formatting cannot join a large track list.
+    append(source.copy(streams = emptyList(), container = source.container?.take(64)).description, " • ")
+    return result.toString()
+  }
+}
