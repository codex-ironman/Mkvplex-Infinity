+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.network
+
+import java.io.ByteArrayInputStream
+import org.junit.Assert.*
+import org.junit.Test
+
+class BoundedInputStreamTest {
+  @Test fun permitsExactLimitAndEof() {
+    val stream = BoundedInputStream(ByteArrayInputStream(ByteArray(8)), 8)
+    assertEquals(8, stream.readBytes().size)
+    assertEquals(8L, stream.bytesRead)
+    assertEquals(-1, stream.read())
+  }
+  @Test fun unknownLengthStopsAtLimitInsteadOfBufferingEntireBody() {
+    val stream = BoundedInputStream(ByteArrayInputStream(ByteArray(1_000)), 8)
+    try { stream.readBytes(); fail("Expected budget failure") } catch (_: ResponseLimitException) {}
+    assertEquals(9L, stream.bytesRead)
+  }
+  @Test fun oneByteReadsAndSkipCannotBypassBudget() {
+    val stream = BoundedInputStream(ByteArrayInputStream(ByteArray(100)), 5)
+    repeat(2) { assertEquals(0, stream.read()) }
+    assertEquals(3L, stream.skip(3))
+    try { stream.skip(1); fail("Expected budget failure") } catch (_: ResponseLimitException) {}
+  }
+  @Test fun emptyBodyAndZeroLengthReadAreValidAtZeroBudget() {
+    val stream = BoundedInputStream(ByteArrayInputStream(byteArrayOf()), 0)
+    assertEquals(0, stream.read(ByteArray(1), 0, 0))
+    assertEquals(-1, stream.read())
+  }
+}
