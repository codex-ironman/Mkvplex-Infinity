@@ -0,0 +1,52 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.network
+
+import java.io.FilterInputStream
+import java.io.IOException
+import java.io.InputStream
+
+internal class ResponseLimitException : IOException("The server response is too large to process safely")
+
+/** Counts decompressed bytes too, including unknown-length/chunked responses. */
+internal class BoundedInputStream(
+  input: InputStream,
+  private val limit: Long,
+  private val checkActive: () -> Unit = {},
+) : FilterInputStream(input) {
+  var bytesRead: Long = 0
+    private set
+
+  init { require(limit >= 0) }
+
+  override fun read(): Int {
+    checkActive()
+    val value = `in`.read()
+    if (value >= 0 && ++bytesRead > limit) throw ResponseLimitException()
+    return value
+  }
+
+  override fun read(buffer: ByteArray, offset: Int, length: Int): Int {
+    if (length == 0) return 0
+    checkActive()
+    val count = `in`.read(buffer, offset, minOf(length.toLong(), limit - bytesRead + 1).coerceAtLeast(1).toInt())
+    if (count > 0) {
+      bytesRead += count
+      if (bytesRead > limit) throw ResponseLimitException()
+    }
+    return count
+  }
+
+  override fun skip(count: Long): Long {
+    val buffer = ByteArray(minOf(count.coerceAtLeast(0), 8_192).toInt())
+    var skipped = 0L
+    while (skipped < count) {
+      val read = read(buffer, 0, minOf(buffer.size.toLong(), count - skipped).toInt())
+      if (read < 0) break
+      skipped += read
+    }
+    return skipped
+  }
+
+  override fun markSupported() = false
+  override fun reset(): Unit = throw IOException("Reset is not supported")
+}
