+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.presentation.components
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class RemoteImagePolicyTest {
+  @Test fun former4095PixelCaseIsSampledToCardBudget() {
+    assertEquals(8, RemoteImagePolicy.sampleSize(4095, 4095, RemoteImageSize.CARD))
+  }
+  @Test fun ordinarySmallPosterKeepsItsResolution() {
+    assertEquals(1, RemoteImagePolicy.sampleSize(400, 600, RemoteImageSize.CARD))
+  }
+  @Test fun wideBackdropUsesHeroBudgetAndNotCardBudget() {
+    assertEquals(2, RemoteImagePolicy.sampleSize(2560, 1440, RemoteImageSize.HERO))
+    assertEquals(4, RemoteImagePolicy.sampleSize(2560, 1440, RemoteImageSize.CARD))
+  }
+  @Test fun dimensionsAndTotalPixelsAreBoundedEvenForExtremeAspectRatios() {
+    for (width in listOf(1, 768, 2049, 4095, 16_000, Int.MAX_VALUE)) {
+      for (height in listOf(1, 768, 2049, 4095, 16_000, Int.MAX_VALUE)) {
+        for (size in RemoteImageSize.entries) {
+          val sample = RemoteImagePolicy.sampleSize(width, height, size)
+          val w = (width.toLong() + sample - 1) / sample
+          val h = (height.toLong() + sample - 1) / sample
+          assertTrue(w <= size.maxDimension && h <= size.maxDimension)
+          assertTrue(w * h <= size.maxPixels)
+        }
+      }
+    }
+  }
+}
