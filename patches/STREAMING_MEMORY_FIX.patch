+
+class JellyfinSourceTextTest {
+  @Test fun longLabelsAndTrackListsAreBoundedBeforeComposeMeasurement() {
+    val label = "A".repeat(1_000_000)
+    val source = JellyfinMediaSource("identity", label, streams = List(100) { JellyfinMediaStream(it, "Audio", displayTitle = label) })
