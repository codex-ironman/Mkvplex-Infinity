diff --git a/app/src/main/java/app/infinity/mpvz/data/jellyfin/JellyfinJsonResponse.kt b/app/src/main/java/app/infinity/mpvz/data/jellyfin/JellyfinJsonResponse.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/app/infinity/mpvz/data/jellyfin/JellyfinJsonResponse.kt
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+package app.infinity.mpvz.data.jellyfin
+
+import app.infinity.mpvz.network.BoundedInputStream
+import app.infinity.mpvz.network.ResponseLimitException
+import com.google.gson.Strictness
+import com.google.gson.stream.JsonReader
+import com.google.gson.stream.JsonToken
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.serialization.ExperimentalSerializationApi
+import kotlinx.serialization.json.*
+import okhttp3.ResponseBody
+import java.io.InputStream
+import java.io.InputStreamReader
+
+/** Projects only used metadata while streaming; unknown/source fields are skipped before allocation. */
+internal object JellyfinJsonResponse {
+  private val parsing = Semaphore(1)
+  private val fields = setOf(
+    "Items", "TotalRecordCount", "ErrorCode", "Id", "Name", "Type", "CollectionType", "Overview",
+    "RunTimeTicks", "CumulativeRunTimeTicks", "IsFolder", "ProductionYear", "CommunityRating", "CriticRating",
+    "OfficialRating", "SeriesName", "SeriesId", "SeriesPrimaryImageTag", "SeasonName", "IndexNumber",
+    "ParentIndexNumber", "ChildCount", "Container", "PremiereDate", "Status", "Genres", "Taglines",
+    "AlbumArtist", "AlbumArtists", "ArtistItems", "Artists", "ImageTags", "Primary", "Logo",
+    "ParentLogoImageTag", "SeriesLogoImageTag", "ParentLogoItemId", "ParentId", "BackdropImageTags",
+    "AlbumId", "AlbumPrimaryImageTag", "ParentPrimaryImageTag", "UserData", "PlaybackPositionTicks",
+    "Played", "IsFavorite", "LastPlayedDate", "MediaSources", "MediaStreams", "Codec", "Width", "Height",
+    "VideoRange", "VideoRangeType", "Channels", "RemoteTrailers", "RemoteTrailerUrl", "Url", "People",
+    "Role", "PrimaryImageTag", "CanDelete", "Path", "Size", "Bitrate", "Index", "Language", "DisplayTitle",
+    "IsExternal", "DeliveryUrl",
+  )
+
+  suspend fun read(body: ResponseBody, includeSources: Boolean = false): JsonElement = parsing.withPermit {
+    try {
+      val context = currentCoroutineContext()
+      read(body.byteStream(), includeSources, checkActive = { context.ensureActive() }).also {
+        val root = it as? JsonObject
+        val sourceCount = (root?.get("MediaSources") as? JsonArray)?.size ?: 0
+        val itemCount = (root?.get("Items") as? JsonArray)?.size ?: (it as? JsonArray)?.size ?: 0
+        app.infinity.mpvz.utils.AppMemoryDiagnostics.record("metadata items=$itemCount links=$sourceCount sources=$includeSources")
+      }
+    } catch (large: ResponseLimitException) {
+      app.infinity.mpvz.utils.AppMemoryDiagnostics.record("metadata rejected: size budget")
+      throw large
+    }
+  }
+
+  fun read(
+    input: InputStream,
+    includeSources: Boolean = false,
+    maxInputBytes: Long = 32L * 1024 * 1024,
+    maxRetainedBytes: Long = 8L * 1024 * 1024,
+    checkActive: () -> Unit = {},
+  ): JsonElement {
+    val bounded = BoundedInputStream(input, maxInputBytes, checkActive)
+    val budget = Budget(maxRetainedBytes)
+    JsonReader(InputStreamReader(bounded, Charsets.UTF_8)).use { reader ->
+      reader.strictness = Strictness.STRICT
+      val root = value(reader, includeSources, budget, 0)
+      check(reader.peek() == JsonToken.END_DOCUMENT) { "Unexpected trailing JSON" }
+      return root
+    }
+  }
+
+  private class Budget(private val maxBytes: Long) {
+    private var used = 0L
+    fun add(bytes: Long) { used += bytes; if (used > maxBytes) throw ResponseLimitException() }
+  }
+
+  @OptIn(ExperimentalSerializationApi::class)
+  private fun value(reader: JsonReader, includeSources: Boolean, budget: Budget, depth: Int): JsonElement {
+    if (depth > 64) throw ResponseLimitException()
+    budget.add(128)
+    return when (reader.peek()) {
+      JsonToken.BEGIN_OBJECT -> {
+        reader.beginObject()
+        val values = linkedMapOf<String, JsonElement>()
+        while (reader.hasNext()) {
+          val name = reader.nextName()
+          if (name !in fields || (!includeSources && name == "MediaSources")) reader.skipValue()
+          else {
+            budget.add(64L + name.length * 2L)
+            values[name] = value(reader, includeSources, budget, depth + 1)
+          }
+        }
+        reader.endObject()
+        JsonObject(values)
+      }
+      JsonToken.BEGIN_ARRAY -> {
+        reader.beginArray()
+        val values = ArrayList<JsonElement>()
+        while (reader.hasNext()) values.add(value(reader, includeSources, budget, depth + 1))
+        reader.endArray()
+        JsonArray(values)
+      }
+      JsonToken.STRING -> {
+        val text = reader.nextString()
+        budget.add(32L + text.length * 2L)
+        JsonPrimitive(text)
+      }
+      JsonToken.NUMBER -> {
+        val text = reader.nextString()
+        budget.add(32L + text.length * 2L)
+        JsonUnquotedLiteral(text)
+      }
+      JsonToken.BOOLEAN -> JsonPrimitive(reader.nextBoolean())
+      JsonToken.NULL -> { reader.nextNull(); JsonNull }
+      else -> error("Invalid JSON value")
+    }
+  }
+}
