+  @Test fun byteBudgetBoundsMetadataAcrossCachedItemsWithoutTruncatingResults() {
+    val cache = JellyfinSourceCache(maxWeightBytes = 1_000)
+    val versions = listOf(source("a").copy(name = "X".repeat(250)))
+    cache.remember(key, versions)
+    cache.remember(key.copy(item = "next"), versions)
+    assertNull(cache.get(key))
+    assertEquals(versions, cache.get(key.copy(item = "next")))
+
+    val oversized = versions.map { it.copy(streams = listOf(
+      JellyfinMediaStream(0, "Subtitle", deliveryUrl = "x".repeat(1_000)),
+    )) }
+    assertEquals(oversized, cache.remember(key.copy(item = "next"), oversized))
+    assertNull(cache.get(key.copy(item = "next")))
+  }
+
+  @Test fun expiredItemsAreReleasedWhileOtherItemsAreUsed() {
+    var now = 0L
+    val cache = JellyfinSourceCache(clock = { now })
+    cache.remember(key, listOf(source("old")))
+    now = 30_000
+    cache.remember(key.copy(item = "new"), listOf(source("new")))
+    // Moving the clock back must not resurrect an expired entry left in the map.
+    now = 1
+    assertNull(cache.get(key))
+  }
 }
